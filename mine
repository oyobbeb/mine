#!/usr/bin/env python3
"""mine · Claude Code와 Codex 작업 콘솔"""
import argparse
import json
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys
import time
import unicodedata

sys.dont_write_bytecode = True
from scheduler import (AGENTS, SELF, Workspace, ask, display, history, limits, native_event,
                       native_options, recommendation, record, refresh_codex, remember_limits)


def safe(text):
    return "".join(ch if ch in "\n\t" or unicodedata.category(ch) != "Cc" else "�" for ch in text)


def tmux(*args, **kwargs):
    return subprocess.run(["tmux", *args], **kwargs)


def target(ws, room, agent):
    return f"mine-{ws.key}-{room.name}-{agent}"


def running(name):
    return tmux("has-session", "-t", "=" + name, stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL).returncode == 0


def terminal(ws, room, agent, model=None, detach=False, popup=False):
    name = target(ws, room, agent)
    if not running(name):
        cli = "codex" if agent == "codex" else "claude"
        executable = shutil.which(cli)
        if not executable:
            raise ValueError(cli + " is missing from PATH")
        launch = [executable, *native_options(ws, room, agent)]
        if cli == "claude":
            launch = ["env", "CLAUDE_CONFIG_DIR=" + ws.env(agent)["CLAUDE_CONFIG_DIR"], *launch]
        if model:
            launch.extend(["--model", model])
        tmux("new-session", "-d", "-s", name, "-c", str(ws.project),
             "exec " + shlex.join(launch), check=True)
    elif model:
        raise ValueError("실행 중인 세션은 순정 CLI에서 모델을 변경하세요.")
    if detach:
        print(name)
    elif popup and os.environ.get("TMUX"):
        socket = tmux("display-message", "-p", "#{socket_path}", capture_output=True,
                      text=True, check=True).stdout.strip()
        attach = ["env", "-u", "TMUX", "tmux", "-S", socket, "attach-session", "-t", "=" + name]
        tmux("display-popup", "-E", "-w", "96%", "-h", "94%", shlex.join(attach), check=True)
    else:
        action = "switch-client" if os.environ.get("TMUX") else "attach-session"
        tmux(action, "-t", "=" + name, check=True)


def status(ws, room):
    for agent in AGENTS:
        windows, at = limits(ws, agent)
        usage = " · ".join(f"{w['name']} {w['used']}% 사용" for w in windows) or "사용량 미확인"
        live = "running" if running(target(ws, room, agent)) else "stopped"
        print(f"{agent:10} {live:8} {usage}  {at or ''}")


def usage_summary(ws):
    rows = []
    for agent in AGENTS:
        windows, at = limits(ws, agent)
        text = " · ".join(f"{w['name']} {w['used']}%" for w in windows) or "사용량 미확인"
        rows.append(f"{agent:10} {text}  {at or ''}")
    return "\n".join(rows)


def rooms(ws):
    return sorted(p.name for p in ws.rooms.iterdir() if p.is_dir()) if ws.rooms.exists() else []


def changes(ws):
    result = subprocess.run(["but","diff"], cwd=ws.project, text=True, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT)
    return safe(result.stdout.strip()) or "변경 없음"


def console(ws, room):
    agent = None
    model = None
    panel = ""
    refresh_after = 0
    while True:
        if sys.stdin.isatty() and sys.stdout.isatty():
            print("\033[2J\033[H", end="")
        entries = history(room)
        print(f"\n[mine]  {safe(str(ws.project))} / {room.name}  ·  {agent or '계정 미선택'}  {model or ''}")
        print("작업 목록   " + "  ".join(rooms(ws)))
        print("최근 대화")
        for entry in entries[-4:]:
            print("  " + safe(display(entry))[:600])
        if not entries:
            print("  첫 작업을 입력하세요.")
        if panel:
            print(panel)
            panel = ""
        print("/projects   /project 경로   /use 계정 [모델]   /native   /files   /history   /room 작업   /recommend 작업   /usage   /quit")
        try:
            line = input("mine › ").strip()
        except (EOFError, KeyboardInterrupt):
            return
        op, _, rest = line.partition(" ")
        try:
            if op == "/quit":
                return
            if op == "/projects":
                panel = "\n".join(safe(p) for p in ws.projects())
            elif op == "/project":
                if not rest.strip():
                    raise ValueError("/project 작업폴더경로")
                selection = Path(rest.strip()).expanduser()
                selected = Workspace(ws.project / selection, state=ws.state)
                room = selected.room("default")
                ws, agent, model = selected, None, None
            elif op == "/room":
                room = ws.room(rest.strip())
                agent, model = None, None
            elif op == "/use":
                parts = rest.split()
                if len(parts) not in (1,2) or parts[0] not in AGENTS:
                    raise ValueError("/use {claude-a|claude-b|codex} [모델]")
                agent, model = parts[0], next(iter(parts[1:]), None)
            elif op == "/history":
                panel = "\n".join(safe(display(entry)) for entry in entries) or "기록 없음"
            elif op == "/files":
                panel = changes(ws)
            elif op == "/usage":
                try:
                    refresh_codex(ws)
                    panel = usage_summary(ws)
                except (OSError, ValueError) as error:
                    panel = safe(str(error)) + "\n" + usage_summary(ws)
            elif op == "/recommend":
                if time.monotonic() >= refresh_after:
                    try:
                        refresh_codex(ws)
                    except (OSError, ValueError):
                        pass
                    refresh_after = time.monotonic() + 60
                panel = recommendation(ws, entries, rest) + "\n" + usage_summary(ws)
            elif op == "/native" and agent:
                # An already running native session retains its chosen model.
                use_model = None if running(target(ws,room,agent)) else model
                terminal(ws, room, agent, use_model, popup=True)
            elif op.startswith("/") and op != "/native":
                panel = "알 수 없는 명령입니다."
            elif line and not agent:
                panel = recommendation(ws, entries, line) + " · /use로 계정을 선택하세요."
            elif line:
                panel = safe(ask(ws, room, agent, line, model))
        except (OSError,ValueError,subprocess.CalledProcessError) as error:
            panel = safe(str(error))


def main():
    ws = Workspace()
    if len(sys.argv) == 4 and sys.argv[1] in ("_event","_usage"):
        op, path, agent = sys.argv[1:]
        payload = json.load(sys.stdin)
        if op == "_event":
            native_event(Path(path), agent, payload)
        else:
            ws.state = Path(path)
            windows = []
            for name in ("five_hour","seven_day"):
                w = (payload.get("rate_limits") or {}).get(name) or {}
                if isinstance(w.get("used_percentage"),(int,float)) and w.get("resets_at"):
                    windows.append(dict(name=name,used=w["used_percentage"],reset=w["resets_at"]))
            if windows:
                remember_limits(ws,agent,windows)
            print("mine · " + agent + "  " + "  ".join(f"{w['name']} {w['used']}%" for w in windows))
        return
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--project", metavar="DIR", help="작업 루트로 사용할 폴더")
    commands = parser.add_subparsers(dest="command")
    commands.add_parser("projects")
    commands.add_parser("rooms")
    commands.add_parser("usage")
    commands.add_parser("login").add_argument("agent",choices=AGENTS)
    for name in ("ui","open","note","history","status","ask","recommend"):
        sub = commands.add_parser(name)
        if name == "ui":
            sub.add_argument("room", nargs="?", default="default")
        else:
            sub.add_argument("room")
        if name in ("open","ask"):
            sub.add_argument("agent", choices=AGENTS)
            sub.add_argument("--model")
        if name == "open":
            sub.add_argument("--detach", action="store_true")
        if name in ("ask","note","recommend"):
            sub.add_argument("message")
    args = parser.parse_args()
    if args.project:
        ws = Workspace(args.project)
    cmd = args.command
    if cmd == "projects":
        for path in ws.projects():
            print(safe(path))
        return
    if cmd == "rooms":
        print("\n".join(rooms(ws)))
        return
    if cmd == "usage":
        try:
            refresh_codex(ws)
        except (OSError, ValueError) as error:
            print(safe(str(error)), file=sys.stderr)
        print(usage_summary(ws))
        return
    if cmd == "login":
        call = ["codex","login"] if args.agent == "codex" else ["claude","auth","login"]
        subprocess.run(call, env=ws.env(args.agent), check=True)
        return
    room = ws.room(getattr(args,"room","default"))
    if cmd in ("ui",None):
        console(ws, room)
    elif cmd == "note":
        record(room, note=args.message)
    elif cmd == "history":
        for entry in history(room):
            print(json.dumps(entry, ensure_ascii=False))
    elif cmd == "open":
        terminal(ws,room,args.agent,args.model,args.detach)
    elif cmd == "status":
        status(ws,room)
    elif cmd == "ask":
        print(safe(ask(ws,room,args.agent,args.message,args.model)))
    elif cmd == "recommend":
        print(recommendation(ws,history(room),args.message))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        sys.exit(f"mine: {safe(str(error))}")
